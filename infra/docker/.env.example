# ── Application ──────────────────────────────────────
APP_PORT=8080

# ── Ollama ───────────────────────────────────────────
# Use "ollama" to connect to the Docker Compose service
# Use "127.0.0.1" when running outside Docker
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# ── Application Secrets ──────────────────────────────
SECRET_KEY=replace_with_a_long_random_string

# ── Monitoring (leave blank to disable) ──────────────
SENTRY_DSN=
