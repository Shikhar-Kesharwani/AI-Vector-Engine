# ── Application ──────────────────────────────────────
APP_PORT=8080

# ── Ollama (local LLM) ───────────────────────────────
# In Docker Compose this should be the service name: ollama
# Locally keep as 127.0.0.1
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# ── Application Secrets ──────────────────────────────
# Add any future API keys here
SECRET_KEY=replace_with_a_long_random_string

# ── Monitoring ───────────────────────────────────────
# Leave blank to disable Sentry; paste your DSN to enable
SENTRY_DSN=
